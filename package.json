{
  "name": "noctra-client",
  "productName": "Noctra Client",
  "desktopName": "Noctra Client",
  "version": "3.10.0",
  "description": "Noctra Client — a Minecraft launcher",
  "homepage": "https://github.com/atlas-thedev/noctra-client",
  "author": {
    "name": "Noctra Client",
    "email": "support@noctra.client"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "test": "node --test \"test/**/*.test.js\"",
    "test:screens": "npm run build && xvfb-run --auto-servernum --server-args=\"-screen 0 1920x1080x24\" electron scripts/verify-screenshot.cjs",
    "start": "npm run build && electron .",
    "bump": "node scripts/bump-version.js",
    "release:ensure": "node scripts/ensure-release.js",
    "release:list": "node scripts/ensure-release.js --list",
    "release:clean": "node scripts/ensure-release.js --clean",
    "release:publish": "node scripts/ensure-release.js --publish",
    "dist": "npm run bump && vite build && electron-builder --win --linux",
    "dist:win": "npm run bump && vite build && electron-builder --win",
    "dist:win:publish": "npm run bump && npm run release:ensure && vite build && electron-builder --win --publish always",
    "dist:linux": "npm run bump && vite build && electron-builder --linux",
    "dist:mac": "npm run bump && vite build && electron-builder --mac",
    "build-release": "bash scripts/build-release.sh",
    "publish": "bash scripts/publish-update.sh",
    "release": "bash scripts/build-release.sh && bash scripts/publish-update.sh",
    "update-server": "node update-server.js",
    "server": "node server/index.js",
    "skin-server": "node server/index.js"
  },
  "build": {
    "appId": "app.noctraclient.desktop",
    "productName": "Noctra Client",
    "publish": {
      "provider": "github",
      "owner": "atlas-thedev",
      "repo": "noctra-client"
    },
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**",
      "electron/**",
      "icon.png",
      "src/assets/noctra-icon.png",
      "src/styles/theme.css",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Noctra-Client-Portable-${version}-${arch}.${ext}",
      "icon": "buildResources/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Noctra Client",
      "artifactName": "Noctra-Client-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "buildResources/icons",
      "artifactName": "Noctra-Client-${version}-${arch}.${ext}",
      "category": "public.app-category.games",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icons",
      "artifactName": "Noctra-Client-${version}-${arch}.${ext}",
      "category": "Game",
      "syncDesktopName": true,
      "synopsis": "A Minecraft launcher"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.13",
    "dotenv": "^18.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.454.0",
    "marked": "^18.0.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "skinview3d": "^3.4.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
